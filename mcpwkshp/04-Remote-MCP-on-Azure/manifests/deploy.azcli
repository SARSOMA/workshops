#!/usr/bin/env bash
# Deploys Microsoft's Azure MCP Server to Azure Container Apps for use as a
# REMOTE MCP server callable from GitHub Copilot CLI (and any other MCP-capable
# client).
#
# DEMO MODE — incoming auth is DISABLED (--dangerously-disable-http-incoming-auth).
# Anyone with the URL can call this server, acting with the Container App's
# managed identity. Use a throwaway subscription and run the cleanup at the end.
#
# Usage:
#   bash deploy.azcli                       # uses defaults below
#   RG=my-rg LOCATION=westus2 bash deploy.azcli   # override via env vars
set -euo pipefail

RG="${RG:-rg-mcp-demo}"
LOCATION="${LOCATION:-eastus}"
ENV_NAME="${ENV_NAME:-env-mcp-demo}"
APP="${APP:-azmcp-demo}"
IMAGE="mcr.microsoft.com/azure-sdk/azure-mcp:latest"

echo ">> Resource group:       $RG"
echo ">> Location:             $LOCATION"
echo ">> ACA environment:      $ENV_NAME"
echo ">> Container App name:   $APP"
echo ">> Image:                $IMAGE"

az extension add --name containerapp --upgrade --only-show-errors >/dev/null

SUB_ID=$(az account show --query id -o tsv)
echo ">> Subscription:         $SUB_ID"

echo ">> Creating resource group…"
az group create -n "$RG" -l "$LOCATION" --only-show-errors >/dev/null

echo ">> Creating Container Apps environment…"
az containerapp env create \
  --name "$ENV_NAME" --resource-group "$RG" --location "$LOCATION" \
  --only-show-errors >/dev/null

echo ">> Creating Container App with Azure MCP…"
az containerapp create \
  --name "$APP" \
  --resource-group "$RG" \
  --environment "$ENV_NAME" \
  --image "$IMAGE" \
  --target-port 5000 \
  --ingress external \
  --transport http \
  --system-assigned \
  --min-replicas 1 --max-replicas 1 \
  --cpu 0.5 --memory 1.0Gi \
  --env-vars \
      ASPNETCORE_ENVIRONMENT=Production \
      ASPNETCORE_URLS=http://0.0.0.0:5000 \
      ALLOW_INSECURE_EXTERNAL_BINDING=true \
      AZURE_TOKEN_CREDENTIALS=ManagedIdentityCredential \
      AZURE_MCP_DANGEROUSLY_DISABLE_HTTPS_REDIRECTION=true \
      AZURE_MCP_DANGEROUSLY_ENABLE_FORWARDED_HEADERS=true \
  --args "--transport, http, --read-only, --outgoing-auth-strategy, UseHostingEnvironmentIdentity, --dangerously-disable-http-incoming-auth"  --only-show-errors >/dev/null

echo ">> Granting the Container App's managed identity Reader on the subscription…"
PRINCIPAL_ID=$(az containerapp identity show \
  --name "$APP" --resource-group "$RG" \
  --query principalId -o tsv)

az role assignment create \
  --assignee-object-id "$PRINCIPAL_ID" \
  --assignee-principal-type ServicePrincipal \
  --role "Reader" \
  --scope "/subscriptions/$SUB_ID" \
  --only-show-errors >/dev/null

FQDN=$(az containerapp show -n "$APP" -g "$RG" \
  --query properties.configuration.ingress.fqdn -o tsv)

cat <<EOF

✅ Deployed.

   Azure MCP URL:  https://${FQDN}/

   (MCP endpoint is the root path, NOT /mcp — /mcp returns 404.)

Add this to ~/.copilot/mcp-config.json (or use /mcp add inside Copilot CLI):

{
  "mcpServers": {
    "azure-mcp-remote": {
      "type": "http",
      "url": "https://${FQDN}/",
      "tools": ["*"]
    }
  }
}

Smoke test:

  curl -s -i "https://${FQDN}/" -X POST \\
    -H 'Content-Type: application/json' \\
    -H 'Accept: application/json, text/event-stream' \\
    --data '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"curl","version":"0"}}}'

When you're done, clean up with:

  az group delete -n ${RG} --yes --no-wait

EOF
